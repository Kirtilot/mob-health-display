{
  "schemaVersion": 1,
  "id": "mob_health_display",
  "version": "${version}",
  "name": "Mob Heart Display",
  "description": "Shows a heart bar above mobs, just like the player's own health bar.",
  "authors": ["Kirtilot"],
  "contact": {
    "homepage": "https://modrinth.com/mod/mob-heart-display",
    "sources": "https://github.com/Kirtilot/mob-health-display",
    "issues": "https://github.com/Kirtilot/mob-health-display/issues"
  },
  "license": "MIT",
  "icon": "assets/mob_health_display/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "de.kirtilot.mobhealthdisplay.client.MobHealthDisplayClient"
    ],
    "main": [
      "de.kirtilot.mobhealthdisplay.MobHealthDisplay"
    ],
    "modmenu": [
      "de.kirtilot.mobhealthdisplay.client.compat.MhdModMenu"
    ]
  },
  "mixins": [
    "mob_health_display.mixins.json",
    {
      "config": "mob_health_display.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  },
  "suggests": {
    "modmenu": "*"
  }
}